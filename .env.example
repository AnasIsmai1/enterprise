# =============================================================================
# Environment configuration. Copy to .env and fill in.
#
# REQUIRED to boot: app, database, redis, JWT_SECRET.
# Everything under "Optional integrations" may be omitted — the app starts
# without them and only fails if you call the service that needs them.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5500
# Comma-separated list of allowed CORS origins
CLIENT_URL=http://localhost:3000

# Rebranding: this one value names the product everywhere (Swagger title,
# API docs page title, email sender name). Nothing hardcodes a product name.
APP_NAME=Enterprise API

# -----------------------------------------------------------------------------
# Database - PostgreSQL 16
# -----------------------------------------------------------------------------
DB_HOST=localhost
# 5433 by default so the dev container does not collide with a Postgres already
# installed on the host. Inside docker-compose the app always uses 5432.
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=enterprise

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Auth (better-auth)
#
# Signing secret — minimum 32 characters. Generate with: openssl rand -base64 48
# BETTER_AUTH_SECRET takes precedence; JWT_SECRET is the fallback so existing
# .env files keep working.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_SECRET=

# Public origin of THIS API. Verification, password reset, and invitation links
# are built from it — set it to the externally reachable URL in production or
# users receive links pointing at localhost.
BETTER_AUTH_URL=http://localhost:5500

# Users must confirm their email before a session is issued. Set to 'false' only
# if you have another verification path.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

AUTH_SESSION_EXPIRATION=7d
AUTH_INVITATION_EXPIRATION=7d

# Sessions and auth rate-limit counters live in Redis (secondaryStorage), so
# both hold across replicas. Credential endpoints get tighter limits than the
# global 100 req/min — see rateLimit in src/modules/auth/auth.config.ts.

# =============================================================================
# Optional integrations
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare R2 - media / static buckets
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_STATIC=

# -----------------------------------------------------------------------------
# Cloudflare R2 - restricted bucket (separate IAM credentials)
# -----------------------------------------------------------------------------
R2_RESTRICTED_ACCESS_KEY=
R2_RESTRICTED_SECRET_KEY=
R2_BUCKET_RESTRICTED=

# -----------------------------------------------------------------------------
# Brevo transactional email
# -----------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Enterprise

# Brevo template IDs. Generate them from templates/brevo/*.html with:
#     BREVO_API_KEY=xkeysib-... pnpm brevo:sync
# which prints these five lines. Sending fails loudly if one is missing rather
# than rendering whatever template happens to occupy that slot.
BREVO_TEMPLATE_VERIFICATION=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_INVITATION=
BREVO_TEMPLATE_ACCOUNT_DELETION=
BREVO_TEMPLATE_ADMIN_ALERT=

# -----------------------------------------------------------------------------
# Sentry error tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Admin / seeding
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
# Seed password for the admin user. Required by `pnpm db:seed`.
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Logging (optional)
#
# trace | debug | info | warn | error | fatal.
# Defaults to debug in development, info in production.
# -----------------------------------------------------------------------------
LOG_LEVEL=

# -----------------------------------------------------------------------------
# Health probe ceilings (optional)
# -----------------------------------------------------------------------------
HEALTH_HEAP_LIMIT_MB=512
HEALTH_DISK_THRESHOLD=0.9

# -----------------------------------------------------------------------------
# Swagger branding (optional)
# -----------------------------------------------------------------------------
SWAGGER_TITLE=Enterprise API
SWAGGER_DESCRIPTION=Enterprise API Documentation
SWAGGER_ROUTE=api/docs
