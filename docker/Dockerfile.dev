# =============================================================================
# DEVELOPMENT DOCKERFILE - hot reload via SWC (pnpm)
# =============================================================================

FROM node:22-alpine AS deps

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 2: dev - development server with hot reload
# -----------------------------------------------------------------------------
FROM deps AS dev

LABEL org.opencontainers.image.source=https://github.com/EagleAnalytix/enterprise
LABEL org.opencontainers.image.description="Enterprise API - Development"
LABEL org.opencontainers.image.licenses=MIT

WORKDIR /app

ENV NODE_ENV=development

COPY . .

COPY docker/entrypoint.dev.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 5500

CMD ["/app/entrypoint.sh"]
