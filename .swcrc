{
  "$schema": "https://json.schemastore.org/swcrc",
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@mod/*": ["src/modules/*"],
      "@@/*": ["./*"]
    },
    "keepClassNames": true,
    "target": "es2022"
  },
  "module": {
    "type": "commonjs",
    "ignoreDynamic": true
  },
  "minify": false
}
