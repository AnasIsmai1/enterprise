{
  "name": "enterprise",
  "version": "0.0.1",
  "description": "Enterprise API",
  "author": "EagleAnalytix",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/EagleAnalytix/enterprise"
  },
  "homepage": "https://github.com/EagleAnalytix/enterprise#readme",
  "bugs": {
    "url": "https://github.com/EagleAnalytix/enterprise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docker:up:dev": "docker compose -f docker/docker-compose.dev.yaml up",
    "docker:down:dev": "docker compose -f docker/docker-compose.dev.yaml down",
    "docker:build:dev": "docker compose -f docker/docker-compose.dev.yaml build",
    "docker:clean:dev": "docker compose -f docker/docker-compose.dev.yaml down -v --remove-orphans",
    "docker:watch:dev": "docker compose -f docker/docker-compose.dev.yaml up --build --watch",
    "docker:logs:dev": "docker compose -f docker/docker-compose.dev.yaml logs -f",
    "docker:status:dev": "docker compose -f docker/docker-compose.dev.yaml ps",
    "docker:up:prod": "docker compose -f docker/docker-compose.yaml up -d",
    "docker:down:prod": "docker compose -f docker/docker-compose.yaml down",
    "docker:build:prod": "docker compose -f docker/docker-compose.yaml build",
    "docker:clean:prod": "docker compose -f docker/docker-compose.yaml down -v --remove-orphans",
    "docker:logs:prod": "docker compose -f docker/docker-compose.yaml logs -f",
    "docker:status:prod": "docker compose -f docker/docker-compose.yaml ps",
    "docker:restart:prod": "docker compose -f docker/docker-compose.yaml restart",
    "db:seed": "npx ts-node -r tsconfig-paths/register --project tsconfig.json src/seeds/index.ts",
    "db:migration:create": "sh -c 'npx typeorm migration:create src/migrations/$0'",
    "db:migration:generate": "sh -c 'npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate src/migrations/$0 -d src/shared/config/typeorm.datasource.ts'",
    "db:migration:run": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/shared/config/typeorm.datasource.ts",
    "db:migration:revert": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/shared/config/typeorm.datasource.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "dev:setup": "sh scripts/setup.sh",
    "module:setup": "sh scripts/module-setup.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.40.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "brevo": "^1.0.0",
    "bullmq": "^5.70.1",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@mod/(.*)$": "<rootDir>/modules/$1"
    }
  }
}
