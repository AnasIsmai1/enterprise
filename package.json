{
  "name": "enterprise",
  "version": "0.0.1",
  "description": "Enterprise API",
  "author": "EagleAnalytix",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/EagleAnalytix/enterprise"
  },
  "homepage": "https://github.com/EagleAnalytix/enterprise#readme",
  "bugs": {
    "url": "https://github.com/EagleAnalytix/enterprise/issues"
  },
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "nest build -b swc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start -b swc",
    "start:dev": "nest start -b swc --watch",
    "start:debug": "nest start -b swc --debug --watch",
    "start:prod": "node dist/main",
    "docker:up:dev": "docker compose -f docker/docker-compose.dev.yaml up",
    "docker:down:dev": "docker compose -f docker/docker-compose.dev.yaml down",
    "docker:build:dev": "docker compose -f docker/docker-compose.dev.yaml build",
    "docker:clean:dev": "docker compose -f docker/docker-compose.dev.yaml down -v --remove-orphans",
    "docker:watch:dev": "docker compose -f docker/docker-compose.dev.yaml up --build --watch",
    "docker:logs:dev": "docker compose -f docker/docker-compose.dev.yaml logs -f",
    "docker:status:dev": "docker compose -f docker/docker-compose.dev.yaml ps",
    "docker:up:prod": "docker compose -f docker/docker-compose.yaml up -d",
    "docker:down:prod": "docker compose -f docker/docker-compose.yaml down",
    "docker:build:prod": "docker compose -f docker/docker-compose.yaml build",
    "docker:clean:prod": "docker compose -f docker/docker-compose.yaml down -v --remove-orphans",
    "docker:logs:prod": "docker compose -f docker/docker-compose.yaml logs -f",
    "docker:status:prod": "docker compose -f docker/docker-compose.yaml ps",
    "docker:restart:prod": "docker compose -f docker/docker-compose.yaml restart",
    "db:seed": "tsx src/seeds/index.ts",
    "db:migration:create": "sh -c 'typeorm migration:create src/migrations/$0'",
    "db:migration:generate": "sh -c 'tsx ./node_modules/typeorm/cli.js migration:generate src/migrations/$0 -d src/shared/config/typeorm.datasource.ts'",
    "db:migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/shared/config/typeorm.datasource.ts",
    "db:migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/shared/config/typeorm.datasource.ts",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --forceExit",
    "dev:setup": "sh scripts/setup.sh",
    "module:setup": "sh scripts/module-setup.sh",
    "prepare": "husky",
    "auth:sql": "tsx scripts/print-auth-sql.ts",
    "brevo:sync": "tsx scripts/brevo-sync-templates.ts",
    "lint:check": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@sentry/nestjs": "^10.69.0",
    "better-auth": "^1.6.26",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest"
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@mod/(.*)$": "<rootDir>/modules/$1"
    }
  }
}
